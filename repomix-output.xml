})
</file>

<file path="prometheus/prometheus.yml">
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "webtracker-api"
    scrape_interval: 5s       
    metrics_path: "/metrics"  
    static_configs:
      - targets:
          - "api:8000"
</file>

<file path="docker-compose.yml">
services:
  postgres-db:
   image: postgres:15-alpine
   container_name: monitor_postgres
   environment:
     POSTGRES_USER: monitor_user
     POSTGRES_PASSWORD: secret123
     POSTGRES_DB: web_monitor
   ports:
    - "5432:5432"
   volumes:
   - postgres_data:/var/lib/postgresql/data
  api:
   build: ./backend
   container_name: monitor_api
   ports:
   - "8000:8000"
   environment:
   - POSTGRES_SERVER=postgres-db
   - POSTGRES_USER=monitor_user
   - POSTGRES_PASSWORD=secret123
   - POSTGRES_DB=web_monitor
   depends_on:
    - postgres-db
  redis-queue:
   image: redis:7-alpine
   container_name: monitor_redis
   ports:
   - "6379:6379"
   depends_on:
   - postgres-db
  worker:
   build: ./backend
   container_name: monitor_worker
   command: ["celery", "-A", "app.tasks", "worker", "--loglevel=info"]
   environment:
    - POSTGRES_SERVER=postgres-db
    - POSTGRES_USER=monitor_user
    - POSTGRES_PASSWORD=secret123
    - POSTGRES_DB=web_monitor
    - PYTHONPATH=/app
   depends_on:
   - postgres-db
   - redis-queue
  celery-beat:
   build: ./backend
   container_name: monitor_beat
   command: ["celery", "-A", "app.tasks", "beat" , "--loglevel=info"] 
   environment:
    - POSTGRES_SERVER=postgres-db
    - POSTGRES_USER=monitor_user
    - POSTGRES_PASSWORD=secret123
    - POSTGRES_DB=web_monitor
    - PYTHONPATH=/app
   depends_on:
    - postgres-db
    - redis-queue
  prometheus:
   image: prom/prometheus:v2.45.0
   container_name: monitor_prometheus
   volumes:
    - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
   ports:
    - "9090:9090"
   depends_on:
    - api
  grafana:
   image: grafana/grafana:10.2.0
   container_name: monitor_grafana
   ports:
    - "3000:3000"
   environment:
   - GF_SECURITY_ADMIN_PASSWORD=admin
   depends_on:
   - prometheus

volumes:
  postgres_data:
</file>

</files>
