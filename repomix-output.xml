<file path="frontend-dashboard/src/components/SiteCard.tsx">
import { Shield, ShieldAlert, Timer } from 'lucide-react'

interface SiteProps {
  id: number
  name: string
  url: string
  is_active: boolean  
  last_status?: number
  latency?: number
}

export default function SiteCard({ name, 
  url, 
  is_active, 
  last_status, 
  latency }: SiteProps) {
  
  const isOnline = last_status === 200
  const hasData = last_status !== null && last_status !== undefined

  return (
    <div className="rounded-2xl border border-zinc-800 bg-zinc-900 p-5 shadow-lg transition-all hover:border-zinc-700">
      <div className="flex items-center justify-between">
        <div>
          <h3 className="text-lg font-bold text-zinc-100">{name}</h3>
          <p className="text-sm text-zinc-400 truncate max-w-[200px]">{url}</p>
        </div>
        
        <span className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${
          isOnline ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400'
        }`}>
          <span className={`h-1.5 w-1.5 rounded-full ${isOnline ? 'bg-emerald-400' : 'bg-rose-400'}`} />
          {hasData ? (isOnline ? 'Operational' : 'Down') : 'Pendiente'}
        </span>
      </div>

      <div className="mt-6 grid grid-cols-2 gap-4 border-t border-zinc-800 pt-4 text-sm text-zinc-400">
        <div className="flex items-center gap-2">
          <Timer className="h-4 w-4 text-teal-400" />
          <span>{latency !== null && latency !== undefined ? `${latency} ms` : '--'}</span>
        </div>
        <div className="flex items-center gap-2">
          {url.startsWith('https') ? (
            <Shield className="h-4 w-4 text-emerald-400" />
          ) : (
            <ShieldAlert className="h-4 w-4 text-amber-400" />
          )}
          <span>{url.startsWith('https') ? 'SSL Secure' : 'No SSL'}</span>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="frontend-dashboard/src/components/SiteForm.tsx">
import { useState } from 'react'
import type { FormEvent } from 'react'
import { PlusCircle } from 'lucide-react'

interface SiteFormProps {
  onAddSite: (name: string, url: string) => void
}

export default function SiteForm({ onAddSite }: SiteFormProps) {
  const [name, setName] = useState('')
  const [url, setUrl] = useState('')

  const handleSubmit = (e: FormEvent) => {
    e.preventDefault()
    
    if (!name.trim() || !url.trim()) return

    onAddSite(name, url)

    setName('')
    setUrl('')
  }

  return (
    <form onSubmit={handleSubmit} className="mb-8 rounded-2xl border border-zinc-800 bg-zinc-900 p-6 shadow-lg">
      <div className="grid gap-4 sm:grid-cols-2">
        <div>
          <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-400">
            Nombre del Sitio
          </label>
          <input
            type="text"
            placeholder="Ej: Servidor Principal"
            value={name}

            onChange={(e) => setName(e.target.value)}
            className="mt-2 w-full rounded-xl border border-zinc-800 bg-zinc-950 p-3 text-zinc-100 placeholder-zinc-600 outline-none transition-colors focus:border-teal-500"
          />
        </div>
        <div>
          <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-400">
            Dirección URL
          </label>
          <input
            type="text"
            placeholder="Ej: https://mi-app.com"
            value={url}
            onChange={(e) => setUrl(e.target.value)}
            className="mt-2 w-full rounded-xl border border-zinc-800 bg-zinc-950 p-3 text-zinc-100 placeholder-zinc-600 outline-none transition-colors focus:border-teal-500"
          />
        </div>
      </div>

      <button
        type="submit"
        className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-teal-500 p-3 font-semibold text-zinc-950 transition-colors hover:bg-teal-400 cursor-pointer"
      >
        <PlusCircle className="h-5 w-5" />
        Añadir Sitio al Monitor
      </button>
    </form>
  )
}
